@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies
#
# The exported target links Threads::Threads, so that imported target has to
# exist before drossTargets.cmake is read.
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)

# Include the exported targets
include("${CMAKE_CURRENT_LIST_DIR}/drossTargets.cmake")

# Check that the targets exist
check_required_components(dross)