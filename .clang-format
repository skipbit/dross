# dross コーディング規約 (CODING_STYLE.md) に基づく clang-format 設定

# 1. 全般
# 言語: C++23
Language: Cpp23
# スタイルのベースとして LLVM を選択し、そこからカスタマイズ
BasedOnStyle: LLVM

# 3. フォーマット
# インデント: 半角スペース4つ
IndentWidth: 4
UseTab: Never

# 1行の文字数: 80文字
ColumnLimit: 80

# 波括弧 ({}) のスタイル
# クラス・制御構文の波括弧は同じ行に置き、関数の波括弧は改行する
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: false           # class MyClass {
  AfterControlStatement: false # if (condition) {
  AfterFunction: true         # void my_function()
                              # {
  AfterNamespace: false       # namespace dross {
  AfterStruct: false          # struct MyStruct {
  AfterEnum: false            # enum MyEnum {
  BeforeCatch: false          # } catch {
  BeforeElse: false           # } else {

# 名前空間の中のクラスや関数の定義は、インデントしない
NamespaceIndentation: None

# 4. コーディングスタイル
# ポインタのアライメント: `*` や `&` を型側に寄せる (Left)
# 例: `std::string& s`
PointerAlignment: Left

# 5. ドキュメンテーション
# コメントを ColumnLimit に合わせてリフローする
ReflowComments: true

# その他、規約の思想に沿った推奨設定
# インクルードをソートする
SortIncludes: true
# using宣言をソートする
SortUsingDeclarations: true
# 短い関数を1行にまとめない
AllowShortFunctionsOnASingleLine: None
# 短いif文を1行にまとめない
AllowShortIfStatementsOnASingleLine: None
# 短いループを1行にまとめない
AllowShortLoopsOnASingleLine: None
# 短いラムダを1行にまとめない
AllowShortLambdasOnASingleLine: None
# 短いcase文を1行にまとめない
AllowShortCaseLabelsOnASingleLine: None
